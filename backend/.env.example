# Copy to .env and adjust locally. .env is gitignored and must never be committed.
# Every variable below is optional; the defaults in app/core/config.py are
# sufficient to boot the API for local development.

# --- Service identity -------------------------------------------------------
# SERVICE_NAME is echoed by GET /health and is part of the frontend contract.
SERVICE_NAME=community-intelligence-api
ENVIRONMENT=development
DEBUG=true

# --- Database ---------------------------------------------------------------
# SQLite is intentional for the hackathon MVP: zero infrastructure, one file,
# trivially reset. The URL form keeps the door open for Postgres later.
DATABASE_URL=sqlite:///./data/community.db
# Log every SQL statement (noisy; useful when debugging ingestion).
DATABASE_ECHO=false

# --- External data sources ---------------------------------------------------
# US Census Data API key. Request one at https://api.census.gov/data/key_signup.html
# Optional: the Census API allows up to 500 requests per day without a key.
# LEAVE THIS BLANK HERE. Put the real value only in .env, which is gitignored.
CENSUS_API_KEY=

# --- CORS -------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
# 5173 is the Vite dev server the frontend runs on.
# 5174 and 5175 are included because Vite increments its port when 5173 is
# already taken; a blocked origin makes the frontend look like it has no backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
